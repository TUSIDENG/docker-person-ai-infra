DEEPSEEK_API_KEY=your_deepseek_api_key
MODELSTUDIO_API_KEY=your_modelstudio_api_key
OPENAI_API_KEY=your_openai_api_key

# Docker socket host
# windows: //./pipe/docker_engine
# linux/mac: /var/run/docker.sock
DOCKER_SOCKET_HOST=//./pipe/docker_engine

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password

# Qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=your_secure_qdrant_key

# Database Management Tools
ADMINER_PORT=8080
REDISINSIGHT_PORT=8001

# n8n Configuration
N8N_PORT=5678
N8N_DB_HOST=db-postgres
N8N_DB_PORT=${POSTGRES_PORT:-5432}
N8N_DB_NAME=n8n
N8N_DB_USER=${POSTGRES_USER:-postgres}
N8N_DB_PASSWORD=${POSTGRES_PASSWORD:-123456}
N8N_EXECUTIONS_MAX_AGE=72

# OpenClaw Configuration
OPENCLAW_PORT=8000
OPENCLAW_GATEWAY_PORT=18799
OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token  # Gateway 认证 Token（必填）
OPENCLAW_VECTOR_STORE_URL="http://db-qdrant:${QDRANT_HTTP_PORT:-6333}"
OPENCLAW_VECTOR_STORE_API_KEY=${QDRANT_API_KEY:-your_secure_qdrant_key}
OPENCLAW_OPENAI_API_BASE="http://model-ollama:11434/v1"
# OPENCLAW_OPENAI_API_KEY=  # 自建 Ollama 服务不需要 API Key，留空或注释