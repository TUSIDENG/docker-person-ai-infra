# ==========================================
# Ollama 配置文件
# ==========================================

# ==========================================
# 容器配置
# ==========================================
# Ollama 容器名称（可选，默认：model-ollama）
# OLLAMA_CONTAINER_NAME=model-ollama

# Ollama 端口配置（可选，默认：11434）
# OLLAMA_PORT=11434

# 模型拉取容器名称（可选，默认：model-ollama-pull）
# OLLAMA_PULL_CONTAINER_NAME=model-ollama-pull

# ==========================================
# 模型配置
# ==========================================
# 大模型配置（可选，默认：gemma2:9b）
# 推荐模型：
# - gemma2:9b (Gemma 2 9B，轻量全能)
# - qwen2.5:7b (Qwen 2.5 7B，中文优秀)
# - deepseek-r1:14b (DeepSeek R1 14B，推理型)
# - llava:7b (LLaVA 7B，多模态)
LLM_MODEL=gemma4:12b

# 向量模型配置（可选，默认：nomic-embed-text）
# 推荐模型：
# - nomic-embed-text (轻量高效，中英文支持)
# - bge-m3 (BGE M3，多语言，支持多粒度)
# - mxbai-embed-large (高性能)
# - qwen2.5-embed:1.5b (Qwen 2.5 嵌入模型)
EMBEDDING_MODEL=bge-m3

# 额外模型配置（可选，逗号分隔多个模型）
# 例如：EXTRA_MODELS=llava:7b,qwen2.5:14b
# EXTRA_MODELS=

# ==========================================
# 代理配置（默认为空，防止拉取识别）
# ==========================================
# HTTP 代理地址（例如：http://host.docker.internal:7890）
# HTTP_PROXY=

# HTTPS 代理地址（例如：http://host.docker.internal:7890）
# HTTPS_PROXY=

# 不使用代理的地址（默认：localhost,127.0.0.1）
# NO_PROXY=localhost,127.0.0.1,ollama

# ==========================================
# 使用示例
# ==========================================
#
# 1. 复制此文件为 .env
#    cp .env.example .env
#
# 2. 根据需要修改配置
#
# 3. 启动服务
#    docker compose up -d
#
# 4. 查看已安装的模型
#    docker compose exec ollama ollama list
#
# 5. 手动拉取其他模型（如需要）
#    docker compose exec ollama ollama pull qwen2.5:7b
