# ==========================================
# Ollama 配置文件
# ==========================================

# ==========================================
# 容器配置
# ==========================================
# Ollama 容器名称（可选，默认：model-ollama）
# OLLAMA_CONTAINER_NAME=model-ollama

# Ollama 端口配置（可选，默认：11434）
# OLLAMA_PORT=11434

# Ollama CLI 容器名称（可选，默认：model-ollama-cli）
# OLLAMA_CLI_CONTAINER_NAME=model-ollama-cli

# ==========================================
# 代理配置（默认为空，防止拉取识别）
# ==========================================
# HTTP 代理地址（例如：http://host.docker.internal:7890）
# HTTP_PROXY=

# HTTPS 代理地址（例如：http://host.docker.internal:7890）
# HTTPS_PROXY=

# 不使用代理的地址（默认：localhost,127.0.0.1）
# NO_PROXY=localhost,127.0.0.1,ollama

# ==========================================
# 使用示例
# ==========================================
#
# 1. 复制此文件为 .env
#    cp .env.example .env
#
# 2. 根据需要修改配置
# 如果需要拉取gemma4:12b模型，建议配置代理，
# 否则拉取速度会特别慢
#
# 3. 启动服务
#    docker compose up ollama -d
#
